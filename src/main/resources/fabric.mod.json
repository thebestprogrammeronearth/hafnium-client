{
  "schemaVersion": 1,
  "id": "hafnium",
  "version": "${version}",
  "name": "Hafnium Client",
  "description": "Open-source Minecraft client mod: purple ClickGUI, HUD and world utilities, and a permission-aware automation framework. Modules that are not implemented yet are labelled as placeholders in the GUI.",
  "authors": [
    "thebestprogrammeronearth"
  ],
  "contact": {
    "homepage": "https://thebestprogrammeronearth.github.io/hafnium-client/",
    "sources": "https://github.com/thebestprogrammeronearth/hafnium-client",
    "issues": "https://github.com/thebestprogrammeronearth/hafnium-client/issues"
  },
  "license": "GPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.hafnium.client.HafniumClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "mixins": [
    "hafnium.mixins.json"
  ]
}